# ===== Polymarket =====
# Wallet (NUNCA commitar valores reais)
PRIVATE_KEY=
WALLET_ADDRESS=
FUNDER_ADDRESS=

# CLOB API credentials
POLY_API_KEY=
POLY_SECRET=
POLY_PASSPHRASE=

# ===== OpenWeatherMap =====
OWM_API_KEY=

# ===== Proxy (DataImpulse / qualquer http(s) proxy com auth) =====
# Formato: http://USER:PASS@HOST:PORT
PROXY_URL=

# ===== Bot =====
# demo  = mercados sintéticos pra ver o dashboard funcionando
# paper = mercados reais, sem executar ordens
# live  = executa ordens (requer py-clob-client e wallet)
MODE=demo

TRADE_SIZE=1.0
MAX_LOT_USD=2.0          # cap em USD por ordem live (paranóia)
MIN_EDGE=0.05            # 5% — começo conservador, suba quando tiver histórico
SCAN_INTERVAL=180
DAILY_LOSS_LIMIT=50.0
MAX_OPEN_POSITIONS=30
BANKROLL=242.0
SIGNATURE_TYPE=2         # 1 = EOA wallet, 2 = Polymarket proxy wallet (default)
# Trava obrigatória pra live: SÓ defina depois de rotacionar uma wallet
# nova cuja chave NUNCA foi compartilhada em lugar nenhum.
LIVE_CONFIRM=

# ===== Server =====
HOST=0.0.0.0
PORT=8000
DB_URL=sqlite+aiosqlite:///./data/dale.db
LOG_LEVEL=INFO
